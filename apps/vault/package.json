{
  "name": "@ap-home/vault",
  "version": "0.0.2-alpha.25",
  "private": true,
  "description": "Demo MCP server: Cloudflare Worker + D1 for profiles + JTI replay. Person-repository with delegation-verified get_profile tool.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8788 --persist-to ../../.wrangler/state-mcp",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply demo-mcp --local --persist-to ../../.wrangler/state-mcp",
    "d1:migrate:remote": "wrangler d1 migrations apply demo-mcp --remote",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agenticprimitives/agent-naming": "1.0.0-alpha.27",
    "@agenticprimitives/audit": "1.0.0-alpha.27",
    "@agenticprimitives/chain-state": "0.0.0-alpha.4",
    "@agenticprimitives/chain-state-viem": "0.0.0-alpha.6",
    "@agenticprimitives/delegation": "1.0.0-alpha.27",
    "@agenticprimitives/edge-runtime": "0.0.0-alpha.9",
    "@agenticprimitives/entitlements": "0.0.0-alpha.5",
    "@agenticprimitives/key-authorization": "0.0.0-alpha.11",
    "@agenticprimitives/key-custody": "1.0.0-alpha.27",
    "@agenticprimitives/mcp-oauth": "0.0.0-alpha.9",
    "@agenticprimitives/mcp-protocol": "0.0.0-alpha.4",
    "@agenticprimitives/mcp-runtime": "1.0.0-alpha.27",
    "@agenticprimitives/rate-control": "0.0.0-alpha.5",
    "@agenticprimitives/rate-control-cloudflare": "0.0.0-alpha.5",
    "@agenticprimitives/surface-catalog": "0.0.0-alpha.5",
    "@agenticprimitives/tool-policy": "1.0.0-alpha.27",
    "@agenticprimitives/types": "1.0.0-alpha.27",
    "@agenticprimitives/vault": "0.0.0-alpha.5",
    "@agenticprimitives/verifiable-credentials": "0.0.0-alpha.24",
    "@agenticprimitives/verification-receipts": "0.0.0-alpha.8",
    "@modelcontextprotocol/sdk": ">=1.29.0 <2",
    "hono": "4.13.0",
    "viem": "2.52.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260605.1",
    "@types/node": "22.19.19",
    "typescript": "5.7.3",
    "wrangler": "4.93.0"
  }
}
